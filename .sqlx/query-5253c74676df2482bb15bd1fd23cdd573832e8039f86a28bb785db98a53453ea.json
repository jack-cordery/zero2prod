{
  "db_name": "PostgreSQL",
  "query": "\n    SELECT \n       t.subscriber_id,\n       t.newsletter_id,\n       s.email,\n       n.title,\n       n.content_text,\n       n.content_html,\n       t.retries\n    FROM email_processing_tasks t\n    JOIN subscriptions s ON s.id = t.subscriber_id\n    JOIN newsletters n ON n.id = t.newsletter_id\n    WHERE t.execute_after < now()\n    FOR UPDATE OF t \n    SKIP LOCKED LIMIT 1;\n    ",
