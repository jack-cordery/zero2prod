  "query": "\n    SELECT n.id, u.username, n.title, COUNT(e.newsletter_id)\n    FROM newsletters n\n    LEFT JOIN users u ON n.user_id = u.user_id \n    LEFT JOIN email_processing_tasks e ON n.id = e.newsletter_id\n    GROUP BY\n    n.id, u.username, n.title\n    ;\n    ",
